<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <!-- Navy stats panel -->
    <LinearLayout
        android:id="@+id/panelStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/space_16"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTotalActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/loading" />

        <TextView
            android:id="@+id/tvYearBreakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/text_on_navy_secondary"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <!-- Search + Action Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        style="@style/Widget.ExamHallAllocation.Card.Bordered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_12"
        app:layout_constraintTop_toBottomOf="@id/panelStats">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ExamHallAllocation.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/action_search"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Year Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupYears"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipYear2"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Second Year (25)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipYear3"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Third Year (24)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipYear4"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Final Year (23)" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Streamlined Primary Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImport"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_weight="1"
                    android:text="Import"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/grt_orange"
                    app:icon="@drawable/ic_upload"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddStudent"
                    style="@style/Widget.ExamHallAllocation.Button.Navy"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="+ Add"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportStudents"
                    style="@style/Widget.ExamHallAllocation.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="Export"
                    android:textColor="@color/navy_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_document"
                    app:iconSize="16dp"
                    app:iconTint="@color/navy_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Students Single-Column List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
