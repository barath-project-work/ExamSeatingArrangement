<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvSno"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="1" />

        <TextView
            android:id="@+id/tvRoom"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="A212" />

        <TextView
            android:id="@+id/tvFloor"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="2" />

        <TextView
            android:id="@+id/tvDept"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="CSE" />

        <TextView
            android:id="@+id/tvYearSem"
            android:layout_width="125dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="2nd Year / Sem 3" />

        <TextView
            android:id="@+id/tvRegFrom"
            android:layout_width="145dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="110325104001 (1)" />

        <TextView
            android:id="@+id/tvRegTo"
            android:layout_width="145dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="110325104015 (15)" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/navy_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="15" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/navy_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="30" />

        <TextView
            android:id="@+id/tvInvigilator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Duty Staff" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/border_color" />
</LinearLayout>
