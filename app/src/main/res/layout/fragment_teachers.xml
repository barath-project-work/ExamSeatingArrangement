<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:id="@+id/headerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportTeachers"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Export"
            app:icon="@drawable/ic_document"
            app:iconSize="16dp"
            app:iconTint="@color/navy_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportTeachers"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Import"
            app:icon="@drawable/ic_upload"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTeacher"
            style="@style/Widget.ExamHallAllocation.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/teachers_add" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTeachers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintTop_toBottomOf="@id/headerActions"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headerActions"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
