<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:id="@+id/headerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewDutyAllocation"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Duty Roster"
            android:textColor="@color/navy_primary"
            app:icon="@drawable/ic_calendar"
            app:iconSize="16dp"
            app:iconTint="@color/navy_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportTeachers"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Export"
            app:icon="@drawable/ic_document"
            app:iconSize="16dp"
            app:iconTint="@color/navy_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportTeachers"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Import"
            app:icon="@drawable/ic_upload"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTeacher"
            style="@style/Widget.ExamHallAllocation.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/teachers_add" />
    </LinearLayout>

    <!-- Faculty Duty Allocation Overview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDutyOverview"
        style="@style/Widget.ExamHallAllocation.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginBottom="@dimen/space_8"
        app:layout_constraintTop_toBottomOf="@id/headerActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDutyOverviewTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Faculty Invigilation Duty Allocation"
                    android:textColor="@color/navy_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllDutyCounts"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Duty Breakdown"
                    android:textColor="@color/navy_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDutyOverviewSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Assessment Test - I · Total number of duties assigned to each teacher"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTeachers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintTop_toBottomOf="@id/cardDutyOverview"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headerActions"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
