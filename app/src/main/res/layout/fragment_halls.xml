<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <TextView
        android:id="@+id/tvWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_banner_red"
        android:drawablePadding="@dimen/space_8"
        android:gravity="center_vertical"
        android:padding="@dimen/space_12"
        android:text="@string/halls_warning"
        android:textColor="@color/status_red_text"
        android:textSize="@dimen/text_small"
        app:drawableStartCompat="@drawable/ic_warning"
        app:drawableTint="@color/status_red_text"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/hallActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_12"
        app:layout_constraintTop_toBottomOf="@id/tvWarning">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportHalls"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Export"
            app:icon="@drawable/ic_document"
            app:iconSize="16dp"
            app:iconTint="@color/navy_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportHalls"
            style="@style/Widget.ExamHallAllocation.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:layout_marginEnd="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_12"
            android:text="Import"
            app:icon="@drawable/ic_upload"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddHall"
            style="@style/Widget.ExamHallAllocation.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minHeight="@dimen/button_height_small"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/halls_add" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHalls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_12"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintTop_toBottomOf="@id/hallActions"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/hallActions"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
